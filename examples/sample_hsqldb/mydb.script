SET DATABASE UNIQUE NAME HSQLDB8B2F3D9A12
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.USERS(ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL PRIMARY KEY, USERNAME VARCHAR(50), EMAIL VARCHAR(100), ROLE VARCHAR(20), ACTIVE BOOLEAN)
CREATE MEMORY TABLE PUBLIC.ORDERS(ORDER_ID INTEGER GENERATED BY DEFAULT AS IDENTITY NOT NULL PRIMARY KEY, USER_ID INTEGER, AMOUNT DECIMAL(10,2), STATUS VARCHAR(30))
CREATE MEMORY TABLE PUBLIC.PRODUCTS(SKU VARCHAR(20) NOT NULL PRIMARY KEY, TITLE VARCHAR(120), PRICE DECIMAL(8,2), IN_STOCK INTEGER)

